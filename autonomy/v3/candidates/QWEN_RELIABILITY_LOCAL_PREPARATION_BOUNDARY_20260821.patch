diff --git a/scripts/local-preparation-boundary-test.js b/scripts/local-preparation-boundary-test.js
new file mode 100644
--- /dev/null
+++ b/scripts/local-preparation-boundary-test.js
@@
+'use strict';
+
+// Regression contract for request-wide failover accounting:
+// 1) synchronous local header/cookie/timezone preparation failure must happen
+//    before markProviderAttempt();
+// 2) it must not call axios/provider I/O;
+// 3) it must not call accountStore.markFailure()/markCaptchaChallenge();
+// 4) it must not add the healthy account to attemptedAccountIds;
+// 5) after preparation succeeds, the account is charged immediately before the
+//    provider path; same-owner rebase semantics remain unchanged.
+
+const fs = require('fs');
+const path = require('path');
+
+const source = fs.readFileSync(path.join(__dirname, '..', 'src', 'qwen-client.js'), 'utf8');
+
+function assert(condition, message) {
+  if (!condition) throw new Error(message);
+}
+
+assert(source.includes("err.code = 'QWEN_LOCAL_PREPARATION'"), 'missing local preparation error boundary');
+assert(source.includes("errorClass: 'local_preparation'"), 'local preparation must have a non-provider error class');
+
+const createStart = source.indexOf('async function generateChatID');
+const sendStart = source.indexOf('async function sendChatRequest');
+const createBody = source.slice(createStart, sendStart);
+assert(createBody.indexOf("buildHeadersForProvider('/c/new-chat', account)") < createBody.indexOf('markProviderAttempt(attemptContext, account)'), 'chat creation must prepare locally before charging provider budget');
+
+const sendBody = source.slice(sendStart);
+const completionHeaders = sendBody.indexOf('buildHeadersForProvider(`/c/${accountChatId}`, account)');
+const existingThreadCharge = sendBody.indexOf('markProviderAttempt(attemptContext, account)', completionHeaders);
+const axiosPost = sendBody.indexOf('const response = await axios.post', completionHeaders);
+assert(completionHeaders >= 0 && existingThreadCharge > completionHeaders && axiosPost > existingThreadCharge, 'existing-thread completion ordering must be prepare -> charge -> provider');
+
+const localCatch = sendBody.indexOf('if (err && err.localPreparation)');
+const providerClassification = sendBody.indexOf('const status = err.response', localCatch);
+assert(localCatch >= 0 && providerClassification > localCatch, 'local preparation error must exit before upstream failure classification');
+
+console.log('QWEN_LOCAL_PREPARATION_BOUNDARY_PASS');
+
*** End Patch