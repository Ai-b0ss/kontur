diff --git a/scripts/failure-persistence-boundary-test.js b/scripts/failure-persistence-boundary-test.js
new file mode 100644
--- /dev/null
+++ b/scripts/failure-persistence-boundary-test.js
@@
+'use strict';
+
+// If durable recording of an already-classified provider outcome fails locally,
+// the request must fail closed as local_persistence. It must not reclassify the
+// disk error as transport, shorten CAPTCHA/rate-limit semantics, or probe a
+// sibling account with uncertain state.
+
+const fs = require('fs');
+const path = require('path');
+
+const source = fs.readFileSync(path.join(__dirname, '..', 'src', 'qwen-client.js'), 'utf8');
+
+function assert(condition, message) {
+  if (!condition) throw new Error(message);
+}
+
+assert(source.includes('function markFailureDurably('), 'missing durable failure wrapper');
+assert(source.includes('function markCaptchaDurably('), 'missing durable CAPTCHA wrapper');
+assert(source.includes("errorClass: 'local_persistence'"), 'local persistence must be fail-closed');
+
+const createStart = source.indexOf('async function generateChatID');
+const sendStart = source.indexOf('async function sendChatRequest');
+const createBody = source.slice(createStart, sendStart);
+assert(createBody.includes('if (err && err.localPersistence) throw err;'), 'chat creation must not reclassify persistence EIO as provider transport');
+
+const sendBody = source.slice(sendStart);
+const persistenceCatch = sendBody.indexOf('if (err && err.localPersistence)');
+const providerClassify = sendBody.indexOf('const failureClass = classifyUpstreamFailure', persistenceCatch);
+assert(persistenceCatch >= 0 && providerClassify > persistenceCatch, 'completion persistence error must exit before provider classification');
+
+assert(!source.includes("accountStore.markCaptchaChallenge(account, 'CAPTCHA in initial SSE response')"), 'initial CAPTCHA must use durable wrapper');
+assert(!source.includes("accountStore.markFailure(account, 'RateLimited in initial SSE response')"), 'initial rate limit must use durable wrapper');
+
+console.log('QWEN_FAILURE_PERSISTENCE_BOUNDARY_PASS');
+
*** End Patch
