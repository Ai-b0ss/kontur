+
+class ConversationIntentCapacityExceeded(ConversationPersistenceError):
+    pass
@@
 class ConversationSegmentStore:
+
+    def _unresolved_intent_count_locked(
+        self, items: dict[str, ConversationSegment] | None = None
+    ) -> int:
+        source = self._items if items is None else items
+        return sum(
+            1
+            for item in source.values()
+            if getattr(item, "inflight_fp", None) is not None
+        )
@@
