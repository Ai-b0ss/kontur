--- /dev/null
+++ b/scripts/provider-circuit-persistence-boundary-test.js
@@
+'use strict';
+
+// Once a provider-wide stop condition (WAF/trust/pressure/ambiguous timeout)
+// has been observed, failure to durably record that circuit is local state
+// failure. It must not be reclassified as transport and must never cause a
+// sibling provider request while the safety state is uncertain.
+
+const fs = require('fs');
+const path = require('path');
+
+const source = fs.readFileSync(path.join(__dirname, '..', 'src', 'qwen-client.js'), 'utf8');
+
+function assert(condition, message) {
+  if (!condition) throw new Error(message);
+}
+
+const stopStart = source.indexOf('function stopError(');
+const circuitStart = source.indexOf('function circuitError(', stopStart);
+const stopBody = source.slice(stopStart, circuitStart);
+assert(stopBody.includes("localPersistenceError('provider_circuit_trip', cause)"), 'provider circuit persistence failure must become local_persistence');
+
+const createStart = source.indexOf('async function generateChatID');
+const sendStart = source.indexOf('async function sendChatRequest');
+const createBody = source.slice(createStart, sendStart);
+const createLocal = createBody.indexOf('if (err && err.localPersistence) throw err;');
+const createClassify = createBody.indexOf('const failureClass = classifyUpstreamFailure', createLocal);
+assert(createLocal >= 0 && createClassify > createLocal, 'chat creation must exit on circuit persistence failure before provider reclassification');
+
+const sendBody = source.slice(sendStart);
+const sendLocal = sendBody.indexOf('if (err && err.localPersistence)');
+const sendClassify = sendBody.indexOf('const failureClass = classifyUpstreamFailure', sendLocal);
+assert(sendLocal >= 0 && sendClassify > sendLocal, 'completion must exit on circuit persistence failure before provider reclassification');
+
+console.log('QWEN_PROVIDER_CIRCUIT_PERSISTENCE_BOUNDARY_PASS');
+
*** End Patch
