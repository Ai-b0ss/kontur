# Скопировать в .env и заполнить. Настоящий .env в git не попадает.

# Токен бота от @BotFather. Пока не задан — dev-режим:
# подпись initData и членство в чате не проверяются.
BOT_TOKEN=

# ID основного чата. Нужен для getChatMember, сводки и анонсов.
# Узнать: добавить бота в чат и запустить `pnpm -F @kontur/bot chat-id`
MAIN_CHAT_ID=

# Секрет подписи сессий. На проде обязателен и должен быть случайным.
JWT_SECRET=

# Адрес мини-аппа, который бот отдаёт кнопкой в /start
MINIAPP_URL=http://localhost:5173

# Реакция на сообщение, за которое кинули червяка.
# Червяка нет среди разрешённых боту эмодзи, поэтому 🍌 или 🏆.
WORM_REACTION=🍌

# Строка подключения к Postgres. Без неё — локальный PGlite.
DATABASE_URL=

# Точка отсчёта игровых суток
SEASON_START=2026-08-01

# Поднимать бота внутри процесса API. Нужно локально, потому что PGlite
# держит каталог БД эксклюзивно и двумя процессами к нему не подключиться.
# На проде оставить пустым: там два отдельных деплоя.
BOT_IN_PROCESS=1
