+function assertRecoveredPromptAuthority(record, body = {}, headers = {}) {
+  if (!record || !record.recoveryUncertain) return;
+  if (record.systemPromptMode === undefined && record.ownerSystemPrompt === undefined) return;
+
+  const mode = explicitPromptMode(body, headers);
+  const owner = explicitOwnerSystemPrompt(body);
+  const hasSystem = hasIncomingSystemAuthority(body);
+
+  // Explicit engineer is sufficient current authority. An explicit owner field
