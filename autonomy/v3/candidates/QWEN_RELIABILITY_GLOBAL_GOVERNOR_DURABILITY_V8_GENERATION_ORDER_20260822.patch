+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+
+const root = fs.mkdtempSync(path.join(os.tmpdir(), 'qwen-governor-generation-'));
+const stateFile = path.join(root, 'global-pressure.json');
+const modulePath = require.resolve('../src/request-governor');
+const previousFile = process.env.QWEN_WAFMIN2_STATE_FILE;
+
+function state(generation, updatedAt, patch = {}) {
+  return {
+    version: 3,
+    generation,
+    starts: [],
+    usage: [],
+    penaltyUntil: 0,
+    wafStrikes: 0,
+    successStreak: 0,
+    lastWafAt: 0,
+    lastStartAt: 0,
+    lastFailureAt: 0,
+    lastFailureKind: '',
+    updatedAt,
+    ...patch,
+  };
+}
+
+function loadGovernor() {
+  delete require.cache[modulePath];
+  process.env.QWEN_WAFMIN2_STATE_FILE = stateFile;
+  return require('../src/request-governor');
+}
+
+(async () => {
+  try {
+    const now = Date.now();
+
+    // Same timestamp/generation but different safety state is not cleanup-only.
+    fs.writeFileSync(stateFile, JSON.stringify(state(5, now)), 'utf8');
+    let artifact = `${stateFile}.tmp-same-generation`;
+    fs.writeFileSync(artifact, JSON.stringify(state(5, now, {
+      penaltyUntil: now + 600000,
+      wafStrikes: 2,
+    })), 'utf8');
+    let governor = loadGovernor();
+    await assert.rejects(
+      () => governor.before('account-a', { chars: 100 }),
+      (error) => error && error.code === 'QWEN_GLOBAL_GOVERNOR_STATE_UNCERTAIN',
+      'different same-generation state must not be deleted as stale',
+    );
+    fs.rmSync(artifact, { force: true });
+
+    // Newer generation wins even if wall clock moved backwards.
+    fs.writeFileSync(stateFile, JSON.stringify(state(5, now)), 'utf8');
+    artifact = `${stateFile}.tmp-clock-backwards`;
+    fs.writeFileSync(artifact, JSON.stringify(state(6, now - 10000, {
+      penaltyUntil: now + 600000,
+      wafStrikes: 2,
+    })), 'utf8');
+    governor = loadGovernor();
+    await assert.rejects(
+      () => governor.before('account-a', { chars: 100 }),
+      (error) => error && error.code === 'QWEN_GLOBAL_GOVERNOR_STATE_UNCERTAIN',
+      'newer generation must remain authoritative over wall-clock ordering',
+    );
+    fs.rmSync(artifact, { force: true });
+
+    // Conversely an older generation is proven stale despite a later timestamp.
+    fs.writeFileSync(stateFile, JSON.stringify(state(6, now)), 'utf8');
+    const backup = `${stateFile}.txn-backup-old-generation`;
+    fs.writeFileSync(backup, JSON.stringify(state(5, now + 10000)), 'utf8');
+    governor = loadGovernor();
+    assert.strictEqual(governor.snapshot('account-a').global.state_uncertain, false);
+    assert.strictEqual(fs.existsSync(backup), false);
+
+    console.log('REQUEST_GOVERNOR_GENERATION_ORDER_PASS equal_generation_divergence_blocked=1 clock_rollback_blocked=1 old_generation_cleanup=1');
+  } finally {
