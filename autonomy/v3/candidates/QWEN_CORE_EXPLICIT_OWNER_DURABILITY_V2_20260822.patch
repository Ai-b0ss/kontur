+function restoreDurablePromptAuthority(originalBody, effectiveBody, record, isContinuationTurn, headers = {}) {
+  if (!isContinuationTurn || !record) return effectiveBody;
+  // A new owner field or a new system message is current authority and always wins.
+  if (explicitOwnerSystemPrompt(originalBody) !== null) return effectiveBody;
+  if (hasIncomingSystemAuthority(originalBody)) return effectiveBody;
