+def durable_replay_fingerprint(
+    body: dict[str, Any], turn_key: str | None, request_kind: str
+) -> str:
+    value = {
+        "turn_id": turn_key,
+        "request_kind": request_kind,
+        "input": response_input_fingerprint(body),
+    }
+    return hashlib.sha256(
+        json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
+    ).hexdigest()
+
+
+async def configured_account_ids() -> set[str]:
+    if account_pool is None:
+        return set()
+    status = await account_pool.status()
+    return {
+        str(item.get("id"))
+        for item in status.get("accounts", [])
+        if isinstance(item, dict) and isinstance(item.get("id"), str) and item.get("id")
+    }
+
+
+def response_has_tool_call(response: dict[str, Any]) -> bool:
+    return any(
+        isinstance(item, dict) and item.get("type") in {"function_call", "custom_tool_call"}
+        for item in response.get("output", [])
+    )
+
+
+async def rehydrate_durable_response(
+    *,
+    response: dict[str, Any],
+    turn_key: str | None,
+    account_id: str,
+    request_kind: str,
+    resolved_model: str,
+) -> JSONResponse | None:
+    if request_kind == "turn" and resolved_model == "gpt-5.6-sol":
+        if response_has_tool_call(response):
+            if account_id not in await configured_account_ids():
+                await foreground_account_reservations.clear(turn_key)
+                return JSONResponse(
+                    {"error": {"message": "persisted tool owner is no longer configured", "type": "restart_replay_unavailable"}},
+                    status_code=409,
+                )
+            await foreground_account_reservations.reserve(turn_key, account_id)
+        else:
+            await foreground_account_reservations.clear(turn_key)
+    return None
+
+
+def project_canonical_response(body: dict[str, Any], response: dict[str, Any]):
+    if not body.get("stream", False):
+        return response
+    output = response.get("output", [])
+    if len(output) != 1 or not isinstance(output[0], dict):
+        return JSONResponse(
+            {"error": {"message": "invalid persisted response", "type": "api_error"}},
+            status_code=500,
+        )
+    async def stream():
+        for event in responses_sse(response, output[0]):
+            yield event
+    return StreamingResponse(stream(), media_type="text/event-stream")
+
+
+def replay_error(message: str, status_code: int = 409) -> JSONResponse:
+    return JSONResponse(
+        {"error": {"message": message, "type": "restart_replay_unavailable"}},
+        status_code=status_code,
+    )
