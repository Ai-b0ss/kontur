+const modulePath = require.resolve('../src/request-governor');
+const previousFile = process.env.QWEN_WAFMIN2_STATE_FILE;
+
+function loadGovernor() {
+  delete require.cache[modulePath];
+  process.env.QWEN_WAFMIN2_STATE_FILE = stateFile;
+  return require('../src/request-governor');
+}
+
+function markerNames() {
+  if (!fs.existsSync(root)) return [];
+  const prefix = path.basename(stateFile) + '.inflight-';
+  return fs.readdirSync(root).filter((name) => name.startsWith(prefix));
+}
+
+(async () => {
+  try {
+    let governor = loadGovernor();
