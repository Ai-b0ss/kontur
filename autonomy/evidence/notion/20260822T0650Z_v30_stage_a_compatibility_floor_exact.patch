     async def get(self, key: str | None) -> ConversationSegment | None:
         if key is None:
             return None
         async with self._guard:
             self._load_locked()
             changed = self._cleanup_locked()
             if changed:
                 self._save_locked()
             return self._items.get(conversation_storage_key(key))
+
+    async def require_persistence_ready(self) -> None:
+        """Fail closed when configured durable state cannot be trusted/written.
+
+        This is the v2 compatibility floor for the later durable-replay schema
+        epoch.  It intentionally treats an in-memory-only store (path=None) as
+        ready so existing unit fakes and explicitly ephemeral uses keep their
+        current behavior.  Product Core uses a configured stable path.
+        """
+        async with self._guard:
+            self._load_locked()
+            if self.path is not None and self._persistence_blocked:
+                raise RuntimeError("durable conversation state is unavailable")
