+def response_context_fingerprint(body: dict[str, Any]) -> str:
+    request_context = {
+        "bridge_prompt_policy": prompt_policy_fingerprint(body),
+        "engineer_instructions": (
+            body.get("instructions")
+            if requested_prompt_mode(body) != "owner"
+            else None
+        ),
+        "tools": body.get("tools"),
+        "tool_choice": body.get("tool_choice"),
+        "text": body.get("text"),
+    }
+    return hashlib.sha256(
+        json.dumps(
+            request_context,
+            ensure_ascii=False,
+            sort_keys=True,
+            separators=(",", ":"),
+        ).encode()
+    ).hexdigest()
