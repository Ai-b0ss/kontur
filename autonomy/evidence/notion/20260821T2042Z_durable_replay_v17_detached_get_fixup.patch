# The V12 spec requires ConversationSegmentStore.get() to return a detached record,
# but the current candidate still returns the live object from self._items.
# Without this overlay, server-side precommit mutation can alter in-memory durable
# state before strict publication and defeat rollback guarantees.

diff --git a/payload/conversation_segments.py b/payload/conversation_segments.py
--- a/payload/conversation_segments.py
+++ b/payload/conversation_segments.py
@@
     async def get(self, key: str | None) -> ConversationSegment | None:
         if key is None:
             return None
         async with self._guard:
             self._load_locked()
             self._cleanup_locked()
-            return self._items.get(conversation_storage_key(key))
+            item = self._items.get(conversation_storage_key(key))
+            return copy.deepcopy(item) if item is not None else None
