diff --git a/src/account-store.js b/src/account-store.js
--- a/src/account-store.js
+++ b/src/account-store.js
@@
 function candidates(preferredAccount = null) {
   if (providerCircuit.current()) return [];
   const ordered = [...accounts.values()].filter(isAvailable).sort((a, b) => ((a.lastUsedAt || 0) - (b.lastUsedAt || 0)) || a.id.localeCompare(b.id));
   if (!ordered.length) return [];
-  const preferred = typeof preferredAccount === 'string' ? get(preferredAccount) : preferredAccount;
-  if (preferred && isAvailable(preferred) && accounts.has(preferred.id)) return [preferred, ...ordered.filter((account) => account.id !== preferred.id)];
+  // Never trust a detached/stale account object supplied by a caller. Resolve
+  // the preferred id back to the canonical in-memory account before checking
+  // availability, otherwise an old object can bypass a newer cooldown.
+  const preferredId = typeof preferredAccount === 'string' ? preferredAccount : preferredAccount && preferredAccount.id;
+  const preferred = preferredId ? get(preferredId) : null;
+  if (preferred && isAvailable(preferred)) return [preferred, ...ordered.filter((account) => account.id !== preferred.id)];
   return ordered;
 }
