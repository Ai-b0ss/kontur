+def response_input_item_fingerprints(body: dict[str, Any]) -> tuple[str, ...]:
+    """Content-free identity of only the ordered Responses input items.
+
+    Unlike response_input_fingerprints(), this deliberately excludes model,
+    tools, instructions and prompt policy. Those fields decide whether a remote
+    thread may continue; they must not let an old input history stop looking old.
+    """
+    value = body.get("input")
+    items = value if isinstance(value, list) else [value] if isinstance(value, str) else []
+    return tuple(
+        hashlib.sha256(
+            json.dumps(
+                {"item": item},
+                ensure_ascii=False,
+                sort_keys=True,
+                separators=(",", ":"),
+            ).encode()
+        ).hexdigest()
+        for item in items
+    )
