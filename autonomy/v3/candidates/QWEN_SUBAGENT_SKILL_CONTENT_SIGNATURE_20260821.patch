+function selectedSkillExecutionContext(tasks) {
+  const fingerprints = {};
+  for (const task of tasks) {
+    if (!Array.isArray(task.skills) || task.skills.length === 0) continue;
+    const technicalBlock = buildTechnicalSkillBlock(task.skills);
+    fingerprints[task.id] = crypto
+      .createHash('sha256')
+      .update(technicalBlock)
+      .digest('hex');
+  }
+  return Object.keys(fingerprints).length
+    ? { selectedSkillContextSha256ByTask: fingerprints }
+    : {};
+}
 
