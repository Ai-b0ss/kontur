+def _stale_filter_bytes(value: str) -> bytearray:
+    if not value:
+        return bytearray(STALE_REPLAY_FILTER_BYTES)
+    raw = base64.b64decode(value.encode("ascii"), validate=True)
+    if len(raw) != STALE_REPLAY_FILTER_BYTES:
+        raise ValueError("invalid stale replay filter length")
+    return bytearray(raw)
+
+
+def _stale_filter_positions(fingerprint: str) -> tuple[int, ...]:
+    digest = hashlib.sha256(fingerprint.encode()).digest()
+    bit_count = STALE_REPLAY_FILTER_BYTES * 8
+    return tuple(
+        int.from_bytes(digest[index * 4:(index + 1) * 4], "big") % bit_count
+        for index in range(STALE_REPLAY_FILTER_HASHES)
+    )
+
+
+def _stale_filter_add(value: str, fingerprint: str) -> str:
+    bits = _stale_filter_bytes(value)
+    for position in _stale_filter_positions(fingerprint):
+        bits[position // 8] |= 1 << (position % 8)
+    return base64.b64encode(bytes(bits)).decode("ascii")
+
+
+def _stale_filter_contains(value: str, fingerprint: str) -> bool:
+    if not value:
+        return False
+    bits = _stale_filter_bytes(value)
+    return all(
+        bool(bits[position // 8] & (1 << (position % 8)))
+        for position in _stale_filter_positions(fingerprint)
+    )
+
+
+def _record_stale_fingerprint(
+    recent: tuple[str, ...], filter_value: str, fingerprint: str | None
+) -> tuple[tuple[str, ...], str]:
+    if not fingerprint:
+        return recent, filter_value
+    values = list(recent)
+    values.append(fingerprint)
+    bounded = tuple(dict.fromkeys(values))[-MAX_STALE_REPLAY_FINGERPRINTS:]
+    return bounded, _stale_filter_add(filter_value, fingerprint)
+
