# Apply after V12/V12-fixup/V17/V14/V15/V16/V16-fixup/V18.
#
# V18 deliberately exempted a normal turn while segment.awaiting_compacted_history
# because a legitimate Codex post-compaction input is shorter than the previous
# full history. That exemption is too broad: a delayed stale pre-compaction retry
# can arrive in the same window and be treated as the new post-compaction segment.
#
# V16 already durably stores the exact compact_payload returned to Codex. Responses
# compaction semantics require the compacted output items to be passed into the
# next request. Use a content-free SHA-256 of the opaque compaction item to prove
# that a normal post-compaction request really descends from the latest durable
# compaction, rather than accepting any arbitrary shorter history.

diff --git a/payload/server.py b/payload/server.py
--- a/payload/server.py
+++ b/payload/server.py
@@
 def replay_error(message: str, status_code: int = 409) -> JSONResponse:
@@
     )
+
+
+def compacted_item_fingerprint(item: object) -> str | None:
+    if not isinstance(item, dict) or item.get("type") != "compaction":
+        return None
+    encrypted_content = item.get("encrypted_content")
+    if not isinstance(encrypted_content, str) or not encrypted_content:
+        return None
+    return hashlib.sha256(
+        json.dumps(
+            {"type": "compaction", "encrypted_content": encrypted_content},
+            ensure_ascii=False,
+            sort_keys=True,
+            separators=(",", ":"),
+        ).encode("utf8")
+    ).hexdigest()
+
+
+def durable_compaction_fingerprint(response: object) -> str | None:
+    if not isinstance(response, dict):
+        return None
+    output = response.get("output")
+    if not isinstance(output, list):
+        return None
+    fingerprints = [
+        fingerprint
+        for item in output
+        for fingerprint in [compacted_item_fingerprint(item)]
+        if fingerprint is not None
+    ]
+    # The bridge's compact_payload has exactly one opaque compaction item. More
+    # than one is ambiguous and must not authorize a post-compaction transition.
+    if len(fingerprints) != 1:
+        return None
+    return fingerprints[0]
+
+
+def request_contains_compaction_fingerprint(
+    body: dict[str, Any], expected: str
+) -> bool:
+    value = body.get("input")
+    items = value if isinstance(value, list) else []
+    return any(compacted_item_fingerprint(item) == expected for item in items)
@@
