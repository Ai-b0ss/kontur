{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kontur-igor",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "assets": {
    "directory": "../miniapp/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/telegram/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kontur",
      "database_id": "91e39e7e-70fc-4551-8d3e-48235e70f985",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "DEV_MODE": "false",
    "SEASON_START": "2026-08-07",
    "WORM_REACTION": "🍌",
    "LIVE_CAMPAIGN_V5_ENABLED": "false",
    "LIVE_CAMPAIGN_V5_PUBLISH_ENABLED": "false",
    "V5_BOT_USERNAME": "kontur_igor_test_bot",
    "V5_LLM_PROVIDER": "disabled"
  },
  "triggers": {
    "crons": ["30 4 * * *", "0 6-10 * * *", "0 15 * * *", "0 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}

