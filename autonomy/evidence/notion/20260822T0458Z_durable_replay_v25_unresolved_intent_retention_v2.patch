+        cutoff = time.time() - self.ttl
+        before = len(items)
+        unresolved = {
+            key: item
+            for key, item in items.items()
+            if getattr(item, "inflight_fp", None) is not None
+        }
+        ordinary = {
+            key: item
+            for key, item in items.items()
+            if getattr(item, "inflight_fp", None) is None
+            and item.updated_at >= cutoff
+        }
+
+        # Never resolve an ambiguous remote outcome by forgetting it. General
+        # TTL/LRU may evict only ordinary/finalized conversations. If a loaded
+        # state already contains too many unresolved intents, preserve those
+        # bytes; the strict new-intent path below blocks further provider work
+        # rather than "repairing" ambiguity by deletion.
+        ordinary_budget = max(0, self.maximum - len(unresolved))
+        if len(ordinary) > ordinary_budget:
+            ordinary = dict(
+                sorted(
+                    ordinary.items(),
+                    key=lambda pair: pair[1].updated_at,
+                    reverse=True,
+                )[:ordinary_budget]
+            )
+        kept = {**ordinary, **unresolved}
