+const assert = require('assert');
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+
+const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'qwen-owner-recovery-'));
+const configPath = require.resolve('../src/config');
+const sessionPath = require.resolve('../src/session-store');
+const originalConfig = require(configPath);
+
+function loadStore() {
+  delete require.cache[sessionPath];
+  require.cache[configPath] = {
+    id: configPath,
+    filename: configPath,
+    loaded: true,
+    exports: { ...originalConfig, CONFIG_DIR: tmp },
+  };
+  return require('../src/session-store');
+}
+
+try {
+  let store = loadStore();
+  const recoveredHistory = [
+    { role: 'user', content: 'first request' },
+    { role: 'assistant', content: 'first answer' },
+  ];
+  store.set('owner-recovery', 'chat-owner', {
+    accountId: 'account-a',
+    history: recoveredHistory,
+    systemPromptMode: 'owner',
+    ownerSystemPrompt: 'STALE_OWNER_FROM_BACKUP',
+  });
+
+  // persist() has written a same-generation .bak; corrupt only primary so load
+  // must take the fallback and mark the record uncertain.
+  fs.writeFileSync(path.join(tmp, 'opencode-sessions.json'), '{corrupt primary', 'utf8');
